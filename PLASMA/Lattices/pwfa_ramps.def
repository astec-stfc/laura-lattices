# Beam-driven (PWFA) plasma stage with adiabatic matching ramps, then a 0.5 m drift to a screen.
#
# The stage runs in Wake-T by default; to run it in FBPIC instead:
#     framework.change_Lattice_Code("PWFAR", "fbpic")
# Both read the same element (YAML/Plasma/PLA-PWFAR-PLASMA-01.yaml) and the
# same drive + witness beam (Generators/make_beams.py).
global:
  FBPICsettings:
    boost: False          # beam-driven: lab frame (the boost is laser-based)
    number_of_modes: 1    # the stage is axisymmetric
    diag_period: 5000     # ~6 snapshots over the ~28k steps
files:
  PWFAR:
    code: waket
    input:
      particle_definition: '$master_lattice$Data_Files/pwfa_ramps_driver_witness'
    output:
      start_element: PLA-PWFAR-SIM-START-01
      end_element: PLA-PWFAR-SIM-END-01
  PWFAR_DIAG:
    code: ocelot
    output:
      start_element: PLA-PWFAR-SIM-END-01
      end_element: PLA-PWFAR-DIA-SCR-01
layout: "./layouts.yaml"
section: "./sections.yaml"
element_list: "./YAML/"
